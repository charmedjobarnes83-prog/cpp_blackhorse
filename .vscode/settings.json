{
    // 新建/保存的文件统一 UTF-8（与编译参数 -finput-charset=UTF-8 呼应）
    "files.encoding": "utf8",
    // 集成终端启动时自动切到 UTF-8 代码页(65001)，配合 exe 的 UTF-8 输出：
    // 点▶按钮直接跑、F5 调试管道，两种方式汉字都不乱码
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "args": ["-NoLogo", "-NoExit", "-Command", "chcp 65001"]
        },
        "Command Prompt": {
            "path": "cmd.exe",
            "args": ["/k", "chcp 65001"]
        }
    },
    "cmake.generator": "MinGW Makefiles",
    "markdown.extension.toc.updateOnSave": true,

    // ===== 只保留基础补全，屏蔽大段代码补全 =====
    // 打字时弹出补全列表，可提示 include / 关键字 / 变量名等单词
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": true,
    "editor.parameterHints.enabled": true,
    // 关闭代码片段(snippet)补全：不再一选就插入一整段 for/if/函数体
    "editor.snippetSuggestions": "none",
    // 关闭行内灰色幽灵建议（AI 那种整行/整段补全）
    "editor.inlineSuggest.enabled": false,

    // ===== 开启保存时自动格式化 =====
    "editor.formatOnSave": true,
    // C/C++ 用微软 C/C++ 扩展(内置 clang-format)来格式化
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    // 缩进风格：4 空格、大括号换行等，可按喜好改
    // ReflowComments: false  -> 不重排注释文字（汉字注释不会被按列宽折断）
    // AlignTrailingComments: false -> 不改动行尾注释的对齐位置
    "C_Cpp.clang_format_style": "{ BasedOnStyle: Microsoft, IndentWidth: 4, ColumnLimit: 120, ReflowComments: false, AlignTrailingComments: false, BreakTemplateDeclarations: Yes }"
}
