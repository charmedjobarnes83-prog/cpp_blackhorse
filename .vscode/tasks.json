{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 配置项目",
            "type": "shell",
            "command": "D:/cmake/cmake-4.4.2-windows-x86_64/cmake-4.4.2-windows-x86_64/bin/cmake.exe",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_CXX_COMPILER=D:/mingw/x86_64-16.1.0-release-posix-seh-ucrt-rt_v14-rev1/mingw64/bin/g++.exe",
                "-DCMAKE_MAKE_PROGRAM=D:/mingw/x86_64-16.1.0-release-posix-seh-ucrt-rt_v14-rev1/mingw64/bin/mingw32-make.exe"
            ]
        },
        {
            "label": "CMake: 增量编译",
            "type": "shell",
            "command": "D:/cmake/cmake-4.4.2-windows-x86_64/cmake-4.4.2-windows-x86_64/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "dependsOn": "CMake: 配置项目",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "D:\\mingw\\x86_64-16.1.0-release-posix-seh-ucrt-rt_v14-rev1\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-std=c++17"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}