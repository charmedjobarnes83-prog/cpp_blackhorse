{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 配置项目",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-mingw",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_CXX_COMPILER=g++",
                "-DCMAKE_MAKE_PROGRAM=mingw32-make"
            ]
        },
        {
            "label": "CMake: 增量编译",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-mingw"
            ],
            "dependsOn": "CMake: 配置项目",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "C/C++: g++.exe build active file",
            "command": "${workspaceFolder}/build.bat",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "dependsOn": "结束当前程序",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Auto build: current file + discovered implementation files"
        },
        {
            "label": "结束当前程序",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "Get-Process -Name '${fileBasenameNoExtension}' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; exit 0"
            ],
            "problemMatcher": []
        }
    ]
}
